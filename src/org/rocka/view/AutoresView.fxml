<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="607.0" prefWidth="1154.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.rocka.controller.AutoresFXController">
    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>

    <left>
        <VBox maxWidth="300" minWidth="300" spacing="10">
            <padding><Insets right="20" /></padding>
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Registrar Autores" />          
            <TextField fx:id="txtNombre_autor" promptText="Nombre" />
            <TextField fx:id="txtApellido_autor" promptText="Apellido" />
            <TextField fx:id="txtNacionalidad" promptText="Nacionalidad" />           
            <TextField fx:id="txtBiografia" promptText="Biografia" />
            <HBox spacing="10">
                <Button onAction="#handleGuardar" prefWidth="120" text="Guardar" />
                <Button onAction="#handleLimpiar" prefWidth="120" text="Limpiar" />
            </HBox>
            <Label fx:id="lblMensaje" />
        </VBox>
    </left>

    <center>
        <VBox spacing="10">
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Lista de Autores" />
            <HBox spacing="10" />
         <TableView prefHeight="386.0" prefWidth="835.0">
           <columns>
               <TableColumn fx:id="colId" prefWidth="120.0" text="ID" />
               <TableColumn fx:id="colNombre" prefWidth="140.0" text="NOMBRE" />
    
               <TableColumn fx:id="colApellido" prefWidth="140.0" text="APELLIDO" />
               <TableColumn fx:id="colNacionalidad" prefWidth="190.0" text="NACIONALIDAD" />
               <TableColumn fx:id="colBiografia" prefWidth="230.0" text="BIOGRAFIA" />
           </columns>
         </TableView>
             <Button onAction="#handleActualizar" text="Actualizar Tabla" />
             <Button onAction="#handleVolver" text="Volver al Menú" />
        </VBox>
    </center>
</BorderPane>
