<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.rocka.controller.CategoriaFXController">
    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>

    <left>
        <VBox maxWidth="300" minWidth="300" spacing="10">
            <padding><Insets right="20" /></padding>
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Registrar Categoria" />
            <TextField fx:id="txtID" promptText="CUI" text="Ingresa ID" />
            <TextField fx:id="txtNombre" promptText="Nombre" text="Nombre de Categoria" />
            <HBox spacing="10">
                <Button onAction="#handleGuardar" prefWidth="120" text="Guardar" />
                <Button onAction="#handleLimpiar" prefWidth="120" text="Limpiar" />
            </HBox>
            <Label fx:id="lblMensaje" />
        </VBox>
    </left>

    <center>
        <VBox spacing="10">
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Lista de Categorias" />
            <TableView fx:id="tablaCategoria">
                <columns>
                    <TableColumn prefWidth="120" text="Id de categoria">
                        <cellValueFactory>
                            <PropertyValueFactory property="ID" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="200" text="Nombre de categoria">
                        <cellValueFactory>
                            <PropertyValueFactory property="nombre" />
                        </cellValueFactory>
                    </TableColumn>
                </columns>
            </TableView>
            <HBox spacing="10">
                <Button onAction="#handleActualizar" text="Actualizar Tabla" />
                <Button onAction="#handleVolver" text="Volver al Menú" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
